# secrets_example
#
# This file documents the local credentials used by the FX90 Simulator.
#
# To configure the simulator:
#   1. Copy this file to `.secrets`.
#   2. Replace the example values with your own values.
#   3. Do NOT commit `.secrets` to Git.
#
# Docker Compose loads `.secrets` as an env_file.
# The `.secrets` file is intentionally excluded from source control.
#
# TLS certificate and key files generated in `certs/` are also excluded from Git.
#
FX90_USERNAME=admin
FX90_PASSWORD=change-me
FX90_BEARER_TOKEN=change-me
